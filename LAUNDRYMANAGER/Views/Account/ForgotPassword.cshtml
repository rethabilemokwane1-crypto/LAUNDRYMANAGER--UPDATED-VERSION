@model LaundryManager.Models.ForgotPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - iWS Laundry Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="laundry-page iws-themed">
    <div class="container">
        <div class="row justify-content-center align-items-center vh-100">
            <div class="col-md-5 col-lg-4">
                <div class="card glass-card">
                    <div class="card-body p-4">

                        <div class="text-center mb-3">
                            <img src="~/images/logo.png" alt="iWS Laundry" class="brand-logo" />
                            <h3 class="fw-bold mt-3 mb-1">Forgot Password</h3>
                            <p class="text-muted small mb-0">
                                Students and residence managers both reset here.
                            </p>
                        </div>

                        <form asp-action="ForgotPassword" method="post">
                            <div class="text-danger small mb-3" asp-validation-summary="All"></div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">Email address</label>
                                <input asp-for="Email" class="form-control" autocomplete="email"
                                       placeholder="221098765@@mywsu.ac.za or manager@@gmail.com" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="alert alert-light border small py-2 mb-4">
                                <div><i class="bi bi-mortarboard me-1"></i><strong>Student:</strong> your 9-digit WSU email</div>
                                <div><i class="bi bi-house-heart me-1"></i><strong>Residence manager / admin:</strong> your Gmail address</div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 fw-bold">
                                <i class="bi bi-envelope-arrow-up me-1"></i> Send reset link
                            </button>
                        </form>

                        <div class="text-center mt-4">
                            <a href="/Account/Login" class="small fw-bold text-decoration-none">Back to Login</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
