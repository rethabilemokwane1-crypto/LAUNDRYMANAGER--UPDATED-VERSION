@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Link Sent - iWS Laundry</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="laundry-page iws-themed d-flex align-items-center justify-content-center mb-0">
    <div class="card glass-card text-center" style="max-width: 420px; width: 90%;">
        <div class="card-body p-4">
            <img src="~/images/logo.png" alt="iWS Laundry" class="brand-logo" />
            <h4 class="fw-bold mt-3 mb-2">Reset Link Sent</h4>
            <p class="text-muted">@ViewBag.Message</p>
            <a href="/Account/Login" class="btn btn-primary fw-bold mt-2">Back to Login</a>
        </div>
    </div>
</body>
</html>