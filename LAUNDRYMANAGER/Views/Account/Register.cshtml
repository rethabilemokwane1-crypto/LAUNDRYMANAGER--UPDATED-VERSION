@{
    Layout = null;
    ViewData["Title"] = "Choose Account Type";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Select Account Type - iWS Laundry</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="laundry-page iws-themed d-flex align-items-center justify-content-center vh-100">

    <div class="card glass-card p-4 text-center" style="max-width: 420px; width: 90%;">
        <div class="mb-3">
            <img src="~/images/logo.png" alt="iWS Laundry" class="brand-logo mb-3" />
            <h3 class="fw-bold">Create Account</h3>
            <p class="text-muted small">Select how you will be using the iWS Laundry Portal</p>
        </div>

        <div class="d-grid gap-3 mb-3">
            @* Student form: email + password + residence DROPDOWN *@
            <a asp-controller="Account" asp-action="RegisterStudent"
               class="btn btn-primary py-3 rounded-3 fw-bold text-decoration-none">
                <i class="bi bi-mortarboard me-2"></i>Register as Student
            </a>

            @* Manager form: residence NAME + ADDRESS + Gmail (AdminController.Register) *@
            <a asp-controller="Admin" asp-action="Register"
               class="btn btn-outline-primary py-3 rounded-3 fw-bold text-decoration-none">
                <i class="bi bi-building me-2"></i>Register Residence Manager
            </a>
        </div>

        <div class="mt-2">
            <a href="/Account/ForgotPassword" class="text-secondary small text-decoration-none d-block mb-2">
                Forgot your password?
            </a>
            <a href="/Account/Login" class="text-secondary small text-decoration-none">
                ← Back to Log In
            </a>
        </div>
    </div>
</body>
</html>