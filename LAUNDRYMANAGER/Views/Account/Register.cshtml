@{
    Layout = null;
    ViewData["Title"] = "Choose Account Type";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Select Account Type - iWS Laundry</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="laundry-page d-flex align-items-center justify-content-center vh-100">

    <div class="card p-4 shadow-lg rounded-4 text-center" style="max-width: 420px; width: 90%;">
        <div class="mb-3">
            <div class="display-5 text-success mb-2">
                <i class="bi bi-person-badge"></i>
            </div>
            <h3 class="fw-bold text-dark">Create Account</h3>
            <p class="text-muted small">Select how you will be using the iWS Laundry Portal</p>
        </div>

        <div class="d-grid gap-3 mb-3">
            <a href="/Account/RegisterStudent" class="btn btn-success py-3 rounded-3 fw-bold text-white text-decoration-none">
                🎓 Register as Student
            </a>
            
            <a href="/Admin/Register" class="btn btn-outline-success py-3 rounded-3 fw-bold text-decoration-none">
                🏢 Register Residence Manager
            </a>
        </div>

        <div class="mt-2">
            <a href="/Account/Login" class="text-secondary small text-decoration-none">
                ← Back to Log In
            </a>
        </div>
    </div>
</body>
</html>