@using LaundryManager.Models
@{
    Layout = null;
    var residence = ViewBag.Residence as Residence;
    var machines = ViewBag.Machines as List<Machine> ?? new();
    var bookings = ViewBag.ActiveBookings as List<Booking> ?? new();
    var reports = ViewBag.Reports as List<FaultReport> ?? new();
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(residence?.Name ?? "Residence") - Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="laundry-page">
<nav class="navbar navbar-dark laundry-nav shadow-sm">
    <div class="container">
        <div>
            <span class="navbar-brand fw-bold"><i class="bi bi-droplet-half me-2"></i>iWS Laundry Manager</span>
            <div class="small text-white-50">Residence Manager Portal</div>
        </div>
        <a href="/Account/Logout" class="btn btn-sm btn-outline-light fw-bold">Sign Out</a>
    </div>
</nav>

<div class="container py-4">
    <div class="res-hero shadow-sm mb-4">
        <div>
            <span class="badge rounded-pill text-bg-light mb-2"><i class="bi bi-shield-check me-1"></i>Administrator</span>
            <h1 class="display-6 fw-bold mb-1">@residence?.Name</h1>
            <p class="mb-0"><i class="bi bi-geo-alt-fill me-1"></i>@residence?.Address</p>
        </div>
        <div class="res-washer"><i class="bi bi-washing-machine"></i></div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="stat-tile"><span>Machines</span><strong>@machines.Count</strong></div></div>
        <div class="col-6 col-lg-3"><div class="stat-tile"><span>Available</span><strong class="text-success">@machines.Count(m => m.Status == MachineStatus.Working && !m.IsBooked)</strong></div></div>
        <div class="col-6 col-lg-3"><div class="stat-tile"><span>In use</span><strong class="text-warning">@machines.Count(m => m.IsBooked)</strong></div></div>
        <div class="col-6 col-lg-3"><div class="stat-tile"><span>Fault reports</span><strong class="text-danger">@reports.Count</strong></div></div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="/Machines" class="btn btn-primary fw-bold"><i class="bi bi-gear-fill me-1"></i> Manage Machines</a>
        <a href="/Machines/Create" class="btn btn-outline-primary fw-bold"><i class="bi bi-plus-circle me-1"></i> Add Machine</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card glass-card h-100">
                <div class="card-body">
                    <h4 class="fw-bold mb-3"><i class="bi bi-calendar2-check me-2"></i>Upcoming Bookings</h4>
                    @if (!bookings.Any())
                    {
                        <p class="text-muted mb-0">No active or upcoming bookings for this residence.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead><tr><th>Machine</th><th>Student</th><th>Time</th><th>Duration</th><th>Arrival</th></tr></thead>
                                <tbody>
                                @foreach (var b in bookings)
                                {
                                    var machine = machines.FirstOrDefault(m => m.Id == b.MachineId);
                                    <tr>
                                        <td class="fw-semibold">@machine?.Name</td>
                                        <td class="small">@b.StudentEmail</td>
                                        <td>@b.SlotStart.ToString("HH:mm")–@b.SlotEnd.ToString("HH:mm")</td>
                                        <td>@((int)(b.SlotEnd - b.SlotStart).TotalMinutes) min</td>
                                        <td>
                                            @if (b.ConfirmedAt.HasValue) { <span class="badge text-bg-success">Confirmed</span> }
                                            else if (b.SlotStart <= DateTime.Now) { <span class="badge text-bg-warning">Waiting</span> }
                                            else { <span class="badge text-bg-secondary">Scheduled</span> }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card glass-card h-100">
                <div class="card-body">
                    <h4 class="fw-bold mb-3"><i class="bi bi-tools me-2"></i>Maintenance</h4>
                    @if (!reports.Any())
                    {
                        <div class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>No open fault reports.</div>
                    }
                    else
                    {
                        @foreach (var report in reports.Take(6))
                        {
                            <div class="border rounded-3 p-3 mb-2 bg-white">
                                <div class="fw-bold">@machines.FirstOrDefault(m => m.Id == report.MachineId)?.Name</div>
                                <div class="small text-muted">@report.Description</div>
                                <div class="small mt-1">@report.DateReported.ToString("dd MMM yyyy HH:mm")</div>
                                <form asp-controller="Admin" asp-action="ResolveFault" method="post" class="mt-2">
                                    <input type="hidden" name="machineId" value="@report.MachineId" />
                                    <input type="hidden" name="reportId" value="@report.Id" />
                                    <button class="btn btn-sm btn-success">Mark repaired</button>
                                </form>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
