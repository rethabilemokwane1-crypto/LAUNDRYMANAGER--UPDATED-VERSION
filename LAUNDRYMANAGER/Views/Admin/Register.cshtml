@model LaundryManager.Models.AdminRegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register Residence Manager - iWS Laundry</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="laundry-page iws-themed">
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card glass-card">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <img src="~/images/logo.png" alt="iWS Laundry" class="brand-logo" />
                        <h2 class="fw-bold mt-3">Register as a Residence Manager</h2>
                        <p class="text-muted">Create your residence and its private admin dashboard.</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(ViewBag.Message))
                    {
                        <div class="alert alert-info"><i class="bi bi-envelope-check me-2"></i>@ViewBag.Message</div>
                    }

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <form asp-action="Register" method="post">
                        <div class="mb-3">
                            <label asp-for="ResidenceName" class="form-label fw-semibold">Residence name</label>
                            <input asp-for="ResidenceName" class="form-control" placeholder="e.g. Brandon Mansions" />
                            <span asp-validation-for="ResidenceName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ResidenceAddress" class="form-label fw-semibold">Residence address</label>
                            <textarea asp-for="ResidenceAddress" class="form-control" rows="2" placeholder="Street, suburb, city"></textarea>
                            <span asp-validation-for="ResidenceAddress" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Manager Gmail</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="manager@gmail.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="form-text">Use a Gmail address so we can send verification and account alerts.</div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                                <input asp-for="Password" class="form-control" type="password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm password</label>
                                <input asp-for="ConfirmPassword" class="form-control" type="password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>
                        <button class="btn btn-primary w-100 fw-bold py-2"><i class="bi bi-person-check-fill me-1"></i>Create Manager Account</button>
                    </form>

                    <div class="text-center mt-4">
                        <a href="/Account/Login" class="text-decoration-none fw-semibold">Already have an account? Sign in</a>
                        <div class="mt-2">
                            <a href="/Account/Register" class="text-secondary small text-decoration-none">← Back to role choice</a>
                        </div>
                        <div class="mt-1">
                            <a href="/Account/ForgotPassword" class="text-secondary small text-decoration-none">Forgot your password?</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@await Html.PartialAsync("_ValidationScriptsPartial")
</body>
</html>
