@model IEnumerable<(DateTime Start, DateTime End, bool IsTaken)>
@using LaundryManager.Models
@{
    Layout = null;
    var machine = ViewBag.Machine as Machine;
    var bookings = ViewBag.Bookings as List<Booking> ?? new();
    var duration = (int?)ViewBag.Duration ?? 60;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Book @machine?.Name - iWS Laundry</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="laundry-page iws-themed">
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <a href="/Home/Index" class="text-white text-decoration-none fw-semibold"><i class="bi bi-arrow-left me-1"></i>Back to laundry</a>
            <div class="card glass-card mt-3">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="machine-icon-box"><i class="bi @(machine?.Type == "Dryer" ? "bi-wind" : "bi-droplet-half")"></i></div>
                        <div>
                            <h2 class="fw-bold mb-0">@machine?.Name</h2>
                            <p class="text-muted mb-0">@machine?.Type • @duration minute booking</p>
                        </div>
                    </div>

                    @if (TempData["BookingError"] != null)
                    {
                        <div class="alert alert-warning">@TempData["BookingError"]</div>
                    }
                    @if (TempData["BookingConfirmation"] != null)
                    {
                        <div class="alert alert-success">@TempData["BookingConfirmation"]</div>
                    }

                    <div class="alert alert-info">
                        <strong><i class="bi bi-info-circle me-1"></i>How reservations work</strong>
                        <ul class="mb-0 mt-2">
                            <li>Each slot reserves the machine for the full <strong>@duration minutes</strong>.</li>
                            <li>When your slot starts, the machine is locked to you.</li>
                            <li>You must confirm arrival within <strong>10 minutes</strong>, otherwise the reservation is treated as a no-show and the machine becomes available.</li>
                        </ul>
                    </div>

                    <h5 class="fw-bold mt-4">Today's schedule</h5>
                    @if (!Model.Any())
                    {
                        <div class="alert alert-secondary">No more slots are available today.</div>
                    }
                    else
                    {
                        <div class="row g-2">
                        @foreach (var slot in Model)
                        {
                            var booking = bookings.FirstOrDefault(b => b.SlotStart < slot.End && slot.Start < b.SlotEnd);
                            <div class="col-6 col-md-4 col-lg-3">
                                @if (slot.IsTaken)
                                {
                                    <div class="slot-card slot-taken">
                                        <strong>@slot.Start.ToString("HH:mm")–@slot.End.ToString("HH:mm")</strong>
                                        <small>@duration minutes</small>
                                        <span><i class="bi bi-lock-fill me-1"></i>Reserved</span>
                                    </div>
                                }
                                else
                                {
                                    <form asp-action="Reserve" method="post">
                                        <input type="hidden" name="machineId" value="@machine?.Id" />
                                        <input type="hidden" name="slotStart" value="@slot.Start.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                        <input type="hidden" name="slotEnd" value="@slot.End.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                        <button class="slot-card slot-free w-100 text-start">
                                            <strong>@slot.Start.ToString("HH:mm")–@slot.End.ToString("HH:mm")</strong>
                                            <small>@duration minutes</small>
                                            <span><i class="bi bi-calendar-plus me-1"></i>Book slot</span>
                                        </button>
                                    </form>
                                }
                            </div>
                        }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
