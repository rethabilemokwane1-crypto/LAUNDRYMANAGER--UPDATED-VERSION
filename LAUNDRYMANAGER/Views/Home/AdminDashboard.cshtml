@model IEnumerable<LaundryManager.Models.FaultReport>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - WSU Laundry Maintenance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="bg-light">

    <!-- Admin Specific Navigation bar -->
    <nav class="navbar navbar-dark bg-dark shadow-sm mb-4">
        <div class="container">
            <span class="navbar-brand fw-bold text-warning">
                <i class="bi bi-shield-lock-fill me-2"></i>WSU Laundry Admin Portal
            </span>
            <div class="d-flex align-items-center">
                <span class="text-white-50 me-3 small">
                    <i class="bi bi-person-badge me-1"></i> Maintenance Mode
                </span>
                <a href="/Machines" class="btn btn-sm btn-outline-warning fw-bold me-2">
                    <i class="bi bi-list-ul me-1"></i> Manage Machines
                </a>
                <a href="/Account/Logout" class="btn btn-sm btn-outline-light fw-bold">Sign Out</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row mb-4">
            <div class="col">
                <h2 class="fw-bold text-dark">Active Maintenance Requests</h2>
                
                <p class="text-muted">Review student feedback reports and clear assets once repairs are finalized.</p>
            </div>
        </div>

        <!-- Fault Reports Table Queue -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-check-circle display-4 text-success d-block mb-3"></i>
                        <span class="fw-bold">All systems nominal!</span> No active appliance faults reported.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-uppercase fs-7 font-monospace">
                                <tr>
                                    <th class="ps-4">Machine ID</th>
                                    <th>Reported Description / Student Feedback</th>
                                    <th class="text-end pe-4">Management Tool</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var report in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">
                                            <i class="bi bi-tools text-secondary me-2"></i>Asset #@report.MachineId
                                        </td>
                                        <td>
                                            <div class="p-2 bg-light rounded border-start border-danger border-3 small">
                                                @report.Description
                                            </div>
                                        </td>
                                        <td class="text-end pe-4">
                                            <form action="/Home/ResolveFault" method="post" class="d-inline">
                                                <input type="hidden" name="machineId" value="@report.MachineId" />
                                                <input type="hidden" name="reportId" value="@report.Id" />
                                                <button type="submit" class="btn btn-sm btn-success fw-bold px-3 shadow-sm">
                                                    <i class="bi bi-wrench-adjustable me-1"></i> Mark Repaired
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <!-- ⬇⬇⬇ PASTE THE NEW BLOCK HERE ⬇⬇⬇ -->
        @{
            var brokenMachines = ViewBag.BrokenMachines as List<LaundryManager.Models.Machine>;
        }

        @if (brokenMachines != null && brokenMachines.Any())
        {
            <div class="row mt-4">
                <div class="col">
                    <h4 class="fw-bold text-dark mb-3">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Machines Currently Down
                    </h4>
                    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                        <div class="card-body p-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-uppercase fs-7 font-monospace">
                                    <tr>
                                        <th class="ps-4">Machine</th>
                                        <th>Type</th>
                                        <th class="pe-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var machine in brokenMachines)
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">@machine.Name</td>
                                            <td>@machine.Type</td>
                                            <td class="pe-4">
                                                @if (machine.Status == LaundryManager.Models.MachineStatus.UnderRepair)
                                                {
                                                    <span class="badge bg-warning text-dark">Under Repair</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Out of Order</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
        <!-- ⬆⬆⬆ END OF NEW BLOCK ⬆⬆⬆ -->
    </div>

</body>
</html>