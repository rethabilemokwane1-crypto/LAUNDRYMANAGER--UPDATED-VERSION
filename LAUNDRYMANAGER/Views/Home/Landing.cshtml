@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>iWS Laundry Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="laundry-page iws-themed d-flex align-items-center justify-content-center mb-0">
    <div class="card glass-card text-center" style="max-width: 420px; width: 90%;">
        <div class="card-body p-4">
            <img src="~/images/logo.png" alt="iWS Laundry" class="brand-logo brand-logo-lg" />
            <h2 class="fw-bold mt-3 mb-2">iWS Laundry Portal</h2>
            <p class="text-muted mb-4">
                Check machine availability, book a washer or dryer, and track your cycle
                in real time — all from your phone.
            </p>

            <div class="d-grid gap-2 mb-3">
                <a href="/Account/Login" class="btn btn-primary btn-lg fw-bold">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Log In
                </a>
                <a href="/Account/Register" class="btn btn-outline-primary btn-lg fw-bold">
                    <i class="bi bi-person-plus me-2"></i>Create Account
                </a>
            </div>

            <p class="text-muted small mb-0">
                Forgot your password?
                <a href="/Account/ForgotPassword" class="fw-bold">Reset it here</a>
            </p>
        </div>
    </div>
</body>
</html>