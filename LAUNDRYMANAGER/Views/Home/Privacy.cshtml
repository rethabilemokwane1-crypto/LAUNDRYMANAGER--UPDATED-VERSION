@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-lg rounded-4">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width:60px; height:60px; background-color: var(--iws-bubble-white);">
                        <i class="bi bi-shield-check fs-3" style="color: var(--iws-water-color);"></i>
                    </div>
                    <h2 class="fw-bold mb-0" style="color: var(--iws-water-color);">@ViewData["Title"]</h2>
                </div>

                <p class="text-muted">
                    This page outlines how the iWS Laundry Portal collects, uses, and protects your information
                    as a WSU student using this system.
                </p>
                <p class="text-muted">
                    We only store what's needed to manage your bookings — your student email, password (securely
                    hashed), and your laundry activity such as machine bookings and fault reports. This information
                    is never shared with third parties and is used solely to operate the laundry booking system for
                    your residence.
                </p>
                <p class="text-muted mb-0">
                    If you have questions about your data, please contact your residence administrator.
                </p>
            </div>
        </div>
    </div>
</div>