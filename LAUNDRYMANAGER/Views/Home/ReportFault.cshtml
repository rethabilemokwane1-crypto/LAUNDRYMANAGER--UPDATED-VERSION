@{
    Layout = null; // Bypasses default templates to keep our layout clean
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Report Fault - iWS Laundry Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: var(--iws-page-bg); min-height: 100vh;">

    <!-- Top Navigation Header -->
    <nav class="navbar navbar-dark shadow-sm mb-5" style="background-color: var(--iws-water-color);">
        <div class="container">
            <span class="navbar-brand fw-bold">
                <i class="bi bi-water me-2"></i>iWS Laundry Portal
            </span>
            <span class="text-white small"><i class="bi bi-person-circle me-1"></i> @ViewBag.StudentEmail</span>
        </div>
    </nav>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <!-- Back Button Navigation Link -->
                <a href="/Home/Index" class="text-decoration-none d-inline-block mb-3 fw-bold" style="color: var(--iws-water-color);">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>

                <!-- Main Interactive Form Card Box -->
                <div class="card shadow-lg border-0 p-4 rounded-4">
                    <div class="text-center mb-3">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                             style="width:60px; height:60px; background-color: var(--iws-bubble-white);">
                            <i class="bi bi-wrench-adjustable fs-3" style="color: var(--iws-water-color);"></i>
                        </div>
                        <h3 class="fw-bold mb-1" style="color: var(--iws-water-color);">Submit Fault Report</h3>
                        <p class="text-muted small mb-0">Report an operational issue directly to the maintenance team.</p>
                    </div>

                    <form action="/Home/ReportFault" method="post">
                        @Html.AntiForgeryToken()
                        <!-- Hidden machine ID passed securely to backend logic -->
                        <input type="hidden" name="machineId" value="@ViewBag.MachineId" />

                        <!-- Readonly Equipment Indicator Field -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-muted">Selected Equipment Asset</label>
                            <input type="text" class="form-control fw-bold text-dark" value="@ViewBag.MachineName" readonly />
                        </div>

                        <!-- FEEDBACK PANEL SECTION -->
                        <div class="mb-4">
                            <label class="form-label fw-bold" style="color: var(--iws-water-color);">
                                <i class="bi bi-chat-left-text me-1"></i> Student Feedback Panel
                            </label>
                            <textarea name="description" class="form-control" rows="5"
                                      placeholder="Explain the problem here... (e.g., The machine took my tokens but the drum won't spin, or it is leaking water from the bottom during the rinse cycle)"
                                      required></textarea>
                            <div class="form-text text-muted">Be as specific as possible so our technicians know what tools to bring.</div>
                        </div>

                        <!-- Action Controls Button Panel -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger w-50 fw-bold shadow-sm">
                                <i class="bi bi-send me-1"></i> Submit Report
                            </button>
                            <a href="/Home/Index" class="btn btn-outline-secondary w-50 fw-bold">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</body>
</html>